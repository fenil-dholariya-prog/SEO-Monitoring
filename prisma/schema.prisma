generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
}

enum ClientType {
  ECOMMERCE
  LEAD_GENERATION
}

enum ReportStatus {
  DRAFT
  GENERATED
  EXPORTED
}

enum ExportFileType {
  PDF
  DOCX
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(TEAM_MEMBER)
  accounts      Account[]
  sessions      Session[]
  connections   GoogleConnection[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model GoogleConnection {
  id                     String   @id @default(cuid())
  userId                 String
  providerAccountId      String
  encryptedAccessToken   String?  @db.Text
  encryptedRefreshToken  String?  @db.Text
  scopes                 String?
  expiresAt              DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerAccountId])
}

model Client {
  id              String      @id @default(cuid())
  name            String
  websiteUrl      String
  clientType      ClientType
  industry        String
  targetCountry   String
  brandColor      String      @default("#2563eb")
  agencyLogoUrl   String?
  clientLogoUrl   String?
  gscPropertyUrl  String?
  ga4PropertyId   String?
  ahrefsProjectId String?
  reports         Report[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([clientType])
  @@index([name])
}

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id                String          @id @default(cuid())
  clientId          String
  month             Int
  year              Int
  startDate         DateTime
  endDate           DateTime
  status            ReportStatus    @default(DRAFT)
  executiveSummary  String?
  winsSummary       String?
  issuesSummary     String?
  nextMonthFocus    String?
  client            Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  gscSnapshot       GscSnapshot?
  ga4Snapshot       Ga4Snapshot?
  ahrefsSnapshot    AhrefsSnapshot?
  aiSearchSnapshot  AiSearchSnapshot?
  onPageWorks       OnPageWork[]
  backlinkWorks     BacklinkWork[]
  blogPlans         BlogPlan[]
  exports           ReportExport[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([clientId, month, year])
  @@index([clientId, year, month])
  @@index([status])
  @@index([year, month])
}

model GscSnapshot {
  id                  String   @id @default(cuid())
  reportId            String   @unique
  clicks              Int
  impressions         Int
  ctr                 Float
  averagePosition     Float
  topQueries          Json
  topPages            Json
  lowCtrOpportunities Json
  keywordMovement     Json
  devicePerformance   Json
  countryPerformance  Json
  createdAt           DateTime @default(now())
  report              Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Ga4Snapshot {
  id              String   @id @default(cuid())
  reportId        String   @unique
  organicUsers    Int
  organicSessions Int
  engagedSessions Int
  engagementRate  Float
  conversions     Int
  revenue         Float?
  transactions    Int?
  topLandingPages Json
  sourceMedium    Json
  ecommerceData   Json?
  leadGenData     Json?
  createdAt       DateTime @default(now())
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model AhrefsSnapshot {
  id                     String   @id @default(cuid())
  reportId               String   @unique
  target                 String
  mode                   String   @default("domain")
  domainRating           Float?
  totalBacklinks         Int
  newBacklinks           Int
  lostBacklinks          Int
  referringDomains       Int
  organicKeywords        Int?
  organicTraffic         Float?
  domainOverview         Json
  backlinks              Json
  referringDomainsData   Json
  lostBacklinksData      Json
  organicKeywordsData    Json
  competitorBacklinkGap  Json
  anchorTextDistribution Json
  topReferringPages      Json
  backlinkQualityNotes   Json
  createdAt              DateTime @default(now())
  report                 Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([target])
  @@index([createdAt])
}

model AiSearchSnapshot {
  id                String   @id @default(cuid())
  reportId          String   @unique
  includeInReport   Boolean  @default(false)
  aiTraffic         Int      @default(0)
  aiSales           Float    @default(0)
  aiConversions     Int      @default(0)
  aiRevenueCurrency String   @default("USD")
  platformBreakdown Json
  visiblePlatforms  Json
  topCitedPages     Json
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  report            Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model OnPageWork {
  id          String   @id @default(cuid())
  reportId    String
  pageUrl     String
  workType    String
  title       String
  description String
  status      String
  impact      String
  createdAt   DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
}

model BacklinkWork {
  id           String   @id @default(cuid())
  reportId     String
  backlinkUrl  String
  targetUrl    String
  anchorText   String
  domainRating Int?
  linkType     String
  status       String
  notes        String?
  createdAt    DateTime @default(now())
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
}

model BlogPlan {
  id            String   @id @default(cuid())
  reportId      String
  topic         String
  targetKeyword String
  searchIntent  String
  targetPage    String
  status        String
  notes         String?
  createdAt     DateTime @default(now())
  report        Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([createdAt])
}

model ReportExport {
  id        String         @id @default(cuid())
  reportId  String
  fileType  ExportFileType
  fileUrl   String
  createdAt DateTime       @default(now())
  report    Report         @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}
