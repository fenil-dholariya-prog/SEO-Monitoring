# Database
DATABASE_URL="postgresql://username:password@hostname:5432/database?sslmode=require"

# Authentication
AUTH_SECRET="replace-with-a-secure-random-secret-generated-with-openssl-rand-base64-32"
AUTH_URL="https://your-render-app-url.onrender.com"
NEXT_PUBLIC_APP_URL="https://your-render-app-url.onrender.com"

# Site Access
SITE_ACCESS_PASSWORD="Fenil@007"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_SCOPES="openid email profile https://www.googleapis.com/auth/webmasters.readonly https://www.googleapis.com/auth/analytics.readonly"

# Token Encryption
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# API Modes (set to false for production)
GOOGLE_API_MOCK_MODE="false"

# Storage
LOCAL_STORAGE_ROOT="./storage/uploads"
